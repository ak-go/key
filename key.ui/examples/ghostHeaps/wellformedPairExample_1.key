\javaSource "./src";

\programVariables{
    bank.Transaction t;
}

\functions{
    GhostField GF;
    JavaField JF;
}

\include "./ghostHeapRules.key";

\problem{
    t != null
     & t.<created>@heap = TRUE
     & t.amount@heap = 100
     & t.active@gHeap = TRUE
     & wellFormedPair(heap, gHeap)

     -> \<{ t.resetAmount()@bank.Transaction; }\>
        ( t.amount@heap = 0
         & t.active@gHeap = FALSE)
}