\javaSource "./src";

\programVariables{
    bank.Transaction t;
}

\functions{
    GhostField GF;
    JavaField JF;
}

\include "./ghostHeapRules.key";

\problem{
    t != null
     & t.<created>@heap = TRUE
     & t.amount@heap = 100
     & t.success@gHeap = TRUE
     & wellFormedPair(heap, gHeap)

     -> \<{ t.getAmount()@bank.Transaction; }\>
        ( t.amount@heap = 100
         & t.success@gHeap = TRUE
        & wellFormedPair(heap, gHeap))
}