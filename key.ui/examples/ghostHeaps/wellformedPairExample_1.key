\javaSource "./src";

\programVariables{
    bank.Transaction t;
}

\functions{
    GhostField GF;
    JavaField JF;
}

\include "./ghostHeapRules.key";

\problem{
    t != null
 & t.<created> = TRUE
 & t.amount = 100
 & t.active = TRUE
 & wellFormedPair(heap, gHeap)

 -> \<{ t.resetActive()@bank.Transaction; }\>
    ( t.amount = 0
     & t.active = FALSE
     & wellFormedPair(heap, gHeap))
}