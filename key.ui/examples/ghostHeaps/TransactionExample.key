\javaSource "./src";

\programVariables{
    bank.Account acc;
    bank.Transaction t1, t2;
}

\include "./ghostHeapRules.key";

\problem{
    acc != null & acc.<created>@heap = TRUE
    & t1 != null & t1.<created>@heap = TRUE
    & t2 != null & t2.<created>@heap = TRUE
    & acc.balance = 10
    & acc.locked = FALSE
    & acc.unsuccessfulWithdraws = 0
    & t1.amount = 20
    & wellFormedPair(heap, gHeap)
    & java.lang.Object::<inv>(heap, gHeap, t1)

    -> \<{ acc.withdraw(t1)@bank.Account;
            acc.withdraw(t2)@bank.Account; }\>
       ( acc.balance = 10
        & acc.unsuccessfulWithdraws = 2
        & acc.locked@gHeap = TRUE
        & acc.lastTransaction@gHeap = t1
        & t1.success@gHeap = FALSE)
}