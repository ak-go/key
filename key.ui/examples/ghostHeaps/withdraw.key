\javaSource "./src";

\programVariables{
    bank.Account acc;
    bank.Transaction t;
}

\include "./ghostHeapRules.key";

\problem{
    acc != null & acc.<created>@heap = TRUE
    & t != null & t.<created>@heap = TRUE
    & acc.balance = 20
    & acc.locked = FALSE
    & acc.unsuccessfulWithdraws = 0
    & t.amount = 10
    & wellFormedPair(heap, gHeap)
    & java.lang.Object::<inv>(heap, gHeap, t)

    -> \<{ acc.withdraw(t)@bank.Account; }\>
       ( acc.balance = 10
        & acc.locked = FALSE
        & acc.unsuccessfulWithdraws = 0
        & acc.lastTransaction@gHeap = t
        & t.success@gHeap = TRUE)
}