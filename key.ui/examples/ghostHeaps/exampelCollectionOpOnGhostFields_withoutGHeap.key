\javaSource "./src";

\programVariables{
    other.SmallExampleCollection c;
}

\problem{
    c.<created>@heap = TRUE
    & c.gd1 != null & c.gd2 != null & c.gd3 != null
    & c.d1 != c.d2 & c.d2 != c.d3 & c.d1 != c.d3
    & c.gd1 != c.gd2 & c.gd2 != c.gd3 & c.gd3 != c.gd1 & c.gd3 != c.gd1
    & wellFormed(heap)

    -> \<{ c.opOnGhostFields()@other.SmallExampleCollection; }\>
       ( c.gd1.gOtherDummy = c.gd3 & c.gd3 = c.gd2.gOtherDummy & c.gd3.ga = 42 & 42 = c.gd2.ga
             & c.gd3.gOtherDummy = c.gd1 & c.gd1.ga = 21)
}