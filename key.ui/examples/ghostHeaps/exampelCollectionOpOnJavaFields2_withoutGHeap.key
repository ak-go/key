\javaSource "./src";

\programVariables{
    other.SmallExampleCollection c;
}

\problem{
    c.<created>@heap = TRUE
    & c.d1 != null & c.d2 != null & c.d3 != null
    & c.d1 != c.d2 & c.d2 != c.d3 & c.d1 != c.d3
    & wellFormed(heap)

    -> \<{ c.opOnJavaFields2()@other.SmallExampleCollection; }\>
       ( c.d1.otherDummy = c.d3 & c.d1.a = 12
       & c.d2.a = 3 & c.d3.otherDummy = c.d2 & c.d3.a = 12
       & c.gd1.gOtherDummy = c.d1 & c.gd1.gOtherDummy.ga = c.d2.a)
}