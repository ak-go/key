\javaSource "./src";

\programVariables{
    bank.Transaction t;
}

\include "./ghostHeapRules.key";

\problem{
    t != null
    & t.<created> = TRUE
    & t.amount = 100
    & t.success@gHeap = TRUE
    & wellFormedPair(heap, gHeap)

    -> \<{ t.success = false;
           t.amount = 0;}\>
       ( t.amount = 0
        & t.success@gHeap = FALSE
        & wellFormedPair(heap, gHeap) )
}