\javaSource "./src";

\programVariables{
    bank.Transaction t;
}

\functions{
    GhostField GF;
}

\include "./ghostHeapRules.key";

\problem{
    t != null
    & t.<created> = TRUE
    & wellFormedPair(heap, gHeap)
    & t.amount = 100
    & t.active = TRUE

    -> \<{ t.resetActive()@bank.Transaction; }\>
        t.amount = 0
        & t.active = FALSE
        & wellFormedPair(heap, gHeap)
}