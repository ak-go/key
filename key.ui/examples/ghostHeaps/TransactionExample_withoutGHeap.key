\javaSource "./src";

\programVariables{
    bank.Account acc;
    bank.Transaction t1, t2;
}

//\include "./ghostHeapRules.key";

\problem{
    acc != null & acc.<created> = TRUE
    & t1 != null & t1.<created> = TRUE
    & t2 != null & t2.<created> = TRUE
    & acc.balance = 10
    & acc.locked = FALSE
    & acc.unsuccessfulWithdraws = 1
    & t1.amount = 20
    & t2.amount = 30
    & acc.lastTransaction = t1
    & t1.success = FALSE
    & wellFormed(heap)
    //& java.lang.Object::<inv>(heap, t1)
    //& java.lang.Object::<inv>(heap, t2)

    -> \<{ acc.withdraw(t2)@bank.Account; }\>
       ( acc.balance = 10
        & acc.unsuccessfulWithdraws = 2
        & acc.locked = TRUE
        & acc.lastTransaction = t2
        & t2.success = FALSE )
}