\javaSource "./src";

\programVariables{
    other.SmallExampleCollection c;
}

\problem{
    c.<created>@heap = TRUE
    & c.d1 != null & c.d3 != null
    & c.gd1 != c.d3 & c.gd2 != c.d3 & c.gd1 != c.gd2
    & wellFormed(heap)

    -> \<{ c.opOnGhostFields2()@other.SmallExampleCollection; }\>
       ( c.gd1.gOtherDummy = c.d3 & c.d3 = c.gd2.gOtherDummy & c.d3.ga = 42 & 42 = c.gd2.ga
             & c.d3.gOtherDummy = c.gd1 & c.gd1.ga = 21 & c.d1.a = c.d3.a)
}