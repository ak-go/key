\javaSource "./src";

\programVariables{
    bank.Account acc;
}

\include "./ghostHeapRules.key";

\problem{
    acc != null & acc.<created>@heap = TRUE
    & acc.locked = TRUE
    & acc.unsuccessfulWithdraws = 2
    & wellFormedPair(heap, gHeap)

    -> \<{ acc.unlock()@bank.Account; }\>
       ( acc.locked = FALSE
        & acc.unsuccessfulWithdraws = 0
        & acc.lastTransaction@gHeap != null
        & acc.lastTransaction.success@gHeap = TRUE)
}