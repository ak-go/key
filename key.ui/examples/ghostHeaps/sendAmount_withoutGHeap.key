\javaSource "./src";

\programVariables{
    bank.Account acc1, acc2;
    bank.Transaction t;
}

\problem{
    acc1 != null & acc1.<created>@heap = TRUE
    & acc2 != null & acc2.<created>@heap = TRUE
    & t != null & t.<created>@heap = TRUE
    & acc1.balance = 20 & acc2.balance = 0
    & acc1.locked = FALSE & acc2.locked = FALSE
    & acc1.unsuccessfulWithdraws = 0 & acc2.unsuccessfulWithdraws = 0
    & t.amount = 10
    & wellFormed(heap)
    & java.lang.Object::<inv>(heap, t)

    -> \<{ acc1.sendAmount(acc2, t)@bank.Account; }\>
       ( acc1.balance = 10 & acc2.balance = 10
        & acc1.locked = FALSE & acc2.locked = FALSE
        & acc1.unsuccessfulWithdraws = 0 & acc2.unsuccessfulWithdraws = 0
        & acc1.lastTransaction = t & acc2.lastTransaction = t
        & t.success = TRUE)
}