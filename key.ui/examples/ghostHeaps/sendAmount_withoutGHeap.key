\javaSource "./src";

\programVariables{
    bank.Account acc;
}

\problem{
    acc != null & acc.<created>@heap = TRUE
    & acc.balance = 20
    & acc.locked = FALSE
    & acc.unsuccessfulWithdraws = 0
    & wellFormed(heap)

    -> \<{ int amount = 10; acc.sendAmount(amount)@bank.Account; }\>
       ( acc.balance = 10
        & acc.locked = FALSE
        & acc.unsuccessfulWithdraws = 0
        & acc.lastTransaction.success = TRUE )
}