\sorts{
    \generic G;
    \generic deltaObject \extends java.lang.Object;
    \generic alpha, beta, gamma;
}

\predicates {
    wellFormedPair(Heap, Heap); // 1. normaler Heap, 2. geister Heap
}

\schemaVariables {
    \modalOperator {diamond, box, diamond_transaction, box_transaction} #allmodal;
}


\programVariables{ Heap gHeap; }

\rules(programRules:Java, runtimeExceptions:ban) {

    /*
    *   rules for JavaField and GhostField
    */

    type_split_field_axiom {
        \schemaVar \variable Field f;
        \add( \forall f; (GhostField::instance(f) = TRUE | JavaField::instance(f) = TRUE) ==> )
    };

    type_split_field {
        \schemaVar \term Field f;
        \find(f)
        \sameUpdateLevel
        \add((GhostField::instance(f) = TRUE | JavaField::instance(f) = TRUE) ==> )
    };

   instanceof_GhostField { // nicht nötig
        \schemaVar \term GhostField f;
        \find(GhostField::instance(f) = TRUE)
        \replacewith(true)
        \heuristics(concrete)
    };

    /*
    *   rules for reading and writing ghost attributes
    */

    ghost_assignment_read_attribute {
        \schemaVar \program Variable #v, #v0, #a;
        \schemaVar \formula post, f;
        \find( ==> \modality{#allmodal}{.. #v0 = #v.#a; ...}\endmodality (post), )
        \varcond(
            \not \static(#a),
            \not \isArrayLength(#a),
            \not \isModelField(#a),
            \hasSort(#a, G),
            \isGhostField(#a),
            \not \isThisReference(#v))
        "Normal Execution (#v != null)":
            \replacewith( ==> {#v0 :=
                G::select(gHeap, #v, #memberPVToField(#a))}\modality{#allmodal}{.. ...}\endmodality (post))
            // \add (==>(#v=null))
            // \if( formel ) \then( heap term) \else( heap term )
        ;

        "Null Reference (#v = null)":
            \replacewith( ==> false)
            \add(#v = null ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    /* alternativ implementation:
    this rule does not distinguish between normal/ghost fields in varcond,
    instead it does so in the replacewith with part
    */
    /*ghost_or_normal_assignment_read_attribute {
        \schemaVar \program Variable #v, #v0, #a;
        \schemaVar \formula post, f;
        \find( ==> \modality{#allmodal}{.. #v0 = #v.#a; ...}\endmodality (post), )
        \varcond(
            \not \static(#a),
            \not \isArrayLength(#a),
            \not \isModelField(#a),
            \hasSort(#a, G),
            \not \isThisReference(#v))
        "Normal Execution (#v != null)":
            \replacewith( ==> {#v0 := \if (GhostField::instance(#memberPVToField(#a)) = TRUE) // wie castet man #a zu einem Term?
                \then(G::select(gHeap, #v, #memberPVToField(#a))}\modality{#allmodal}{.. ...}\endmodality (post))
                \else(G::select(heap, #v, #memberPVToField(#a))}\modality{#allmodal}{.. ...}\endmodality (post)))
            // \add (==>(#v=null))
        ;

        "Null Reference (#v = null)":
            \replacewith( ==> false)
            \add(#v = null ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
    };*/

    ghost_assignment_read_attribute_this {
        \schemaVar \program Variable #v, #v0, #a;
        \schemaVar \formula post;
        \find( ==> \modality{#allmodal}{.. #v0 = #v.#a; ...}\endmodality (post))
        \varcond(
            \not \static(#a),
            \not \isArrayLength(#a),
            \not \isModelField(#a),
            \isGhostField(#a),
            \hasSort(#a, G),
            \isThisReference(#v))
        "Normal Execution":
            \replacewith( ==> {#v0 := G::select(gHeap, #v, #memberPVToField(#a))}\modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    ghost_assignment_write_attribute {
        \schemaVar \program Variable #v, #v0, #a;
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression #se;
        \find( ==> \modality{#allmodal}{.. #v.#a=#se; ...}\endmodality (post))
        \varcond(\not \static(#a),
            \not \isThisReference(#v),
            \isGhostField(#a))
        "Normal Execution (#v != null)":
            \replacewith( ==> {gHeap := store(gHeap, #v, #memberPVToField(#a), #se)}\modality{#allmodal}{.. ...}\endmodality (post))
            // \add (==>(#v=null))
        ;

        "Null Reference (#v = null)":
            \replacewith( ==> false)
            \add(#v = null ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "ghostAssignment"
    };

    ghost_assignment_write_attribute_this {
        \schemaVar \program Variable #v, #v0, #a;
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression #se;
        \find( ==> \modality{#allmodal}{.. #v.#a=#se; ...}\endmodality (post))
        \varcond(\not \static(#a),
            \isThisReference(#v),
            \isGhostField(#a))
        "Normal Execution":
            \replacewith( ==> {gHeap := store(gHeap, #v, #memberPVToField(#a), #se)}\modality{#allmodal}{.. ...}\endmodality (post))

        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "ghostAssignmentThis"
    };

    /*
    *   rules for arrays
    *   (except assignment_to_reference_array_component_transaction)
    */

    /*ghost_assignment_write_array_this_access_normalassign {
        \schemaVar \program Variable #v;
        \schemaVar \formula post;
        \program Type #t;
        \program SimpleExpression #se, #se0, #se1;
        \program ProgramMethod #pm;

        \varcond(\isGhostField( this? ))
        \find(\modality{#allmodal}{.#pm@#t(#v).. this[#se]=#se0; ...}\endmodality (post))
        \replacewith((lt(#se, length(#v)) & lt(-1, #se)) ->
            {gHeap := store(gHeap, #v, arr(#se), #se0)}\modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "ghostAssignment"
    };*/

    ghost_assignment_to_reference_array_component {
        \schemaVar \modalOperator {diamond, box} #normal;
        \schemaVar \formula post;
        \schemaVar \program Variable #v;
        \schemaVar \program SimpleExpression #se, #se0;

        \find( ==> \modality{#normal}{.. #v[#se]=#se0; ...}\endmodality (post))
        \varcond(\isReferenceArray(#v), \isGhostField(#v))
        "Normal Execution (#v != null)":
            \replacewith( ==> {gHeap := store(gHeap, #v, arr(#se), #se0)}\modality{#normal}{.. ...}\endmodality (post))
            // \add (!(#v=null) & lt(#se, length(#v)) & geq(#se,0) & arrayStoreValid(#v, #se0)==>)
        ;
        "Null Reference (#v = null)":
            \replacewith( ==> false)
            \add(#v = null ==>);
        "Index Out of Bounds (#v != null, but #se Out of Bounds!)":
            \replacewith( ==> false)
            \add(!(#v = null) & (leq(length(#v), #se) | lt(#se, 0)) ==>);
        "Array Store Exception (incompatible dynamic element type of #v and #se0)":
            \replacewith( ==> false)
            \add(!(#v = null) & lt(#se, length(#v)) & geq(#se, 0) & !arrayStoreValid(#v, #se0) ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    ghost_assignment_to_primitive_array_component {
        \schemaVar \modalOperator {diamond, box} #normal;
        \schemaVar \formula post;
        \schemaVar \program Variable #v;
        \schemaVar \program SimpleExpression #se, #se0;

        \find( ==> \modality{#normal}{..#v[#se]=#se0;...}\endmodality (post))
        \varcond(\not \isReferenceArray(#v), \isGhostField(#v))
        "Normal Execution (#v != null)":
            \replacewith( ==> {gHeap := store(gHeap, #v, arr(#se), #se0)}\modality{#normal}{.. ...}\endmodality (post))
            // \add (!(#v=null) & lt(#se, length(#v)) & geq(#se,0)==>)
        ;
        "Null Reference (#v = null)":
            \replacewith( ==> false)
            \add(#v = null ==>);
        "Index Out of Bounds (#v != null, but #se Out of Bounds!)":
            \replacewith( ==> false)
            \add(!(#v = null) & (leq(length(#v), #se) | lt(#se, 0)) ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    ghost_assignment_array2 {
        \schemaVar \program Variable #v, #v0;
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression #se, #se0;

        \find( ==> \modality{#allmodal}{.. #v = #v0[#se]; ...}\endmodality (post))
        \varcond(\hasElementarySort(#v0, G), \isGhostField(#v0))
        "Normal Execution (#v0 != null)":
            \replacewith( ==> {#v := G::select(gHeap, #v0, arr(#se))}\modality{#allmodal}{.. ...}\endmodality (post))
            // \add (==>(#v0=null) | leq(length(#v0), #se) | lt(#se,0))
        ;
        "Null Reference (#v0 = null)":
            \replacewith( ==> false)
            \add(#v0 = null ==>);
        "Index Out of Bounds (#v0 != null, but #se Out of Bounds!)":
            \replacewith( ==> false)
            \add(!(#v0 = null) & (leq(length(#v0), #se) | lt(#se, 0)) ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    ghost_not_created {
        \schemaVar \term Object o,
        \schemaVar \term Heap h, gh;

        \find(o = null)

        \replacewith(boolean::select(h, o, java.lang.Object::<created>) = FALSE &
                                     boolean::select(gh, o, java.lang.Object::<created>) = FALSE)
    }

    /*
    *   rules for ghostWellformed
    */

    // aufteilen für Übersichtlichkeit?
    wellformedPair_object {
        \schemaVar \term Heap h, gh;
        \schemaVar \term Object o;

        \find(wellFormedPair(h, gh))

        \replacewith(wellFormed(h) & wellFormed(gh)
                    // o can exist on h but not on gh at the same time or not at all
                    & (boolean::select(h, o, java.lang.Object::<created>) = FALSE |
                        boolean::select(gh, o, java.lang.Object::<created>) = FALSE))
    };

    wellFormedPair_heap {
        \schemaVar \term Heap h, gh;
        \schemaVar \term Object o;
        \schemaVar \term Field f; // split in GhostField/JavaField?

        \find(wellFormedPair(h, gh))

        \replacewith(wellFormed(h) & wellFormed(gh)
            // o can exist on h but not on gh at the same time or not at all
            & (boolean::select(h, o, java.lang.Object::<created>) = FALSE |
                boolean::select(gh, o, java.lang.Object::<created>) = FALSE)

            // f can be null
            & (((boolean::select(h, o, java.lang.Object::<created>) = FALSE) & (boolean::select(gh, o, java.lang.Object::<created>) = FALSE))   // o on h or gh
                | (boolean::select(h, java.lang.Object::select(h, o, f), java.lang.Object::<created>) = FALSE       // o on h
                  // | boolean::select(h, java.lang.Object::select(gh, o, f), java.lang.Object::<created>) = FALSE      // o on gh
                  // | boolean::select(gh, java.lang.Object::select(h, o, f), java.lang.Object::<created>) = FALSE      // o on h
                   | boolean::select(gh, java.lang.Object::select(gh, o, f), java.lang.Object::<created>) = FALSE))    //o on gh

            // o on h and f is JavaField -> f on h
            & ((boolean::select(h, o, java.lang.Object::<created>) = FALSE | JavaField::instance(f) = FALSE) // & !\isGhostField(f)?
                | boolean::select(h, java.lang.Object::select(h, o, f), java.lang.Object::<created>) = TRUE)

            // o on gh, f is GhostField -> f on gh
            & ((boolean::select(gh, o, java.lang.Object::<created>) = FALSE | GhostField::instance(f) = FALSE)
                | boolean::select(gh, java.lang.Object::select(gh, o, f), java.lang.Object::<created>) = TRUE)

            // o on h, f is GhostField -> f only on gh
            & ((boolean::select(h, o, java.lang.Object::<created>) = FALSE | GhostField::instance(f) = FALSE)
                | (boolean::select(gh, java.lang.Object::select(gh, o, f), java.lang.Object::<created>) = TRUE
                    & boolean::select(h, java.lang.Object::select(gh, o, f), java.lang.Object::<created>) = FALSE)) // sinnvoll, wenn man sowieso von einem festen Heap liest?

            // o on gh, f is JavaField -> f only on h
            & ((boolean::select(gh, o, java.lang.Object::<created>) = FALSE | JavaField::instance(f) = FALSE)
               | (boolean::select(gh, java.lang.Object::select(h, o, f), java.lang.Object::<created>) = FALSE
                   & boolean::select(h, java.lang.Object::select(h, o, f), java.lang.Object::<created>) = TRUE)))
    };
}