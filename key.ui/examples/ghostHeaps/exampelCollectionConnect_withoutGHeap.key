\javaSource "./src";

\programVariables{
    other.SmallExampleCollection c;
    other.DummyObject dres;
}

\problem{
    c.<created>@heap = TRUE
    & c.d1 != null & c.d2 != null & c.d3 != null
    & c.d1 != c.d2 & c.d2 != c.d3 & c.d1 != c.d3
    //& c.dummyArr[0] = c.d1 & c.dummyArr[1] = c.d2 & c.dummyArr[2] = c.d3
    & wellFormed(heap)

    -> \<{ c.connectDummyObjects()@other.SmallExampleCollection; }\>
       ( c.d1.otherDummy = c.dummyArr[1] & c.d2.otherDummy = c.dummyArr[2]
        & c.d3.otherDummy = c.dummyArr[0])
}