\javaSource "./src";

\programVariables{
    bank.Account acc;
    bank.Transaction t;
}

\problem{
    acc != null & acc.<created>@heap = TRUE
    & t != null & t.<created>@heap = TRUE
    & acc.balance = 20
    & acc.locked = FALSE
    & acc.unsuccessfulWithdraws = 0
    & t.amount = 10
    & wellFormed(heap)
    & java.lang.Object::<inv>(heap, t)

    -> \<{ acc.withdraw(t)@bank.Account; }\>
       ( acc.balance = 10
        & acc.locked = FALSE
        & acc.unsuccessfulWithdraws = 0
        & acc.lastTransaction= t
        & t.success= TRUE)
}