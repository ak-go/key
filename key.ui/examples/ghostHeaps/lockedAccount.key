\javaSource "./src";

\programVariables{
    bank.Account acc;
    bank.Transaction t;
}

\include "./ghostHeapRules.key";

\problem{
    acc != null & acc.<created>@heap = TRUE
    & t != null & t.<created>@heap = TRUE
    & acc.balance = 10
    & acc.locked = FALSE
    & acc.unsuccessfulWithdraws@gHeap = 0
    & t.amount = 20
    & wellFormedPair(heap, gHeap)

    -> \<{ acc.unlock()@bank.Account; }\>
       ( acc.balance = 10
        & acc.unsuccessfulWithdraws@gHeap = 0
        & acc.lastTransaction = t )
}