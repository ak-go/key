\javaSource "./src";

\programVariables{
    bank.Account acc;
}

\problem{
    acc != null & acc.<created>@heap = TRUE
    & bank.Account::exactInstance(acc) = TRUE
    & acc.locked = TRUE
    & acc.unsuccessfulWithdraws = 2
    & java.lang.Object::<inv>(heap,acc)
    & wellFormed(heap)
    -> \<{ acc.unlock()@bank.Account; }\>
       ( acc.locked = FALSE
        & acc.unsuccessfulWithdraws = 0
        & acc.lastTransaction != null
        & acc.lastTransaction.success = TRUE)
}