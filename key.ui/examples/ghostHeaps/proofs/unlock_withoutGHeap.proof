\programVariables{
    bank.Account acc;
}
\problem {
     !acc = null
   &   boolean::select(heap,
                       acc,
                       java.lang.Object::<created>)
     = TRUE
   & bank.Account::exactInstance(acc) = TRUE
   &   boolean::select(heap,
                       acc,
                       bank.Account::$locked)
     = TRUE
   &   int::select(heap,
                   acc,
                   bank.Account::$unsuccessfulWithdraws)
     = Z(2(#))
   & java.lang.Object::<inv>(heap, acc)
   & wellFormed(heap)
-> \<{
     acc.unlock()@bank.Account;
   }\> (    boolean::select(heap,
                            acc,
                            bank.Account::$locked)
          = FALSE
        &   int::select(heap,
                        acc,
                        bank.Account::$unsuccessfulWithdraws)
          = Z(0(#))
        & !  bank.Transaction::select(heap,
                                      acc,
                                      bank.Account::$lastTransaction)
           = null
        &   boolean::select(heap,
                            bank.Transaction::select(heap,
                                                     acc,
                                                     bank.Account::$lastTransaction),
                            bank.Transaction::$success)
          = TRUE)
}

