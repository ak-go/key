\programVariables{
    bank.Account acc;
    bank.Transaction t;
}
\problem {
     !acc = null
   &   boolean::select(heap,
                       acc,
                       java.lang.Object::<created>)
     = TRUE
   & !t = null
   &   boolean::select(heap,
                       t,
                       java.lang.Object::<created>)
     = TRUE
   &   int::select(heap, acc, bank.Account::$balance)
     = Z(0(2(#)))
   &   boolean::select(heap,
                       acc,
                       bank.Account::$locked)
     = FALSE
   &   int::select(heap,
                   acc,
                   bank.Account::$unsuccessfulWithdraws)
     = Z(0(#))
   &   int::select(heap, t, bank.Transaction::$amount)
     = Z(0(1(#)))
   & wellFormed(heap)
   & java.lang.Object::<inv>(heap, t)
-> \<{
     acc.withdraw(t)@bank.Account;
   }\> (    int::select(heap,
                        acc,
                        bank.Account::$balance)
          = Z(0(1(#)))
        &   boolean::select(heap,
                            acc,
                            bank.Account::$locked)
          = FALSE
        &   int::select(heap,
                        acc,
                        bank.Account::$unsuccessfulWithdraws)
          = Z(0(#))
        &   bank.Transaction::select(heap,
                                     acc,
                                     bank.Account::$lastTransaction)
          = t
        &   boolean::select(heap,
                            t,
                            bank.Transaction::$success)
          = TRUE)
}

