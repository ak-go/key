\javaSource "src";

\programVariables{
    bank.Account acc;
}

\include "ghostHeapRules.key";
\problem {
     !acc = null
   &   boolean::select(heap,
                       acc,
                       java.lang.Object::<created>)
     = TRUE
   &   int::select(heap, acc, bank.Account::$balance)
     = Z(0(2(#)))
   &   boolean::select(heap,
                       acc,
                       bank.Account::$locked)
     = FALSE
   &   int::select(heap,
                   acc,
                   bank.Account::$unsuccessfulWithdraws)
     = Z(0(#))
   & wellFormedPair(heap, gHeap)
-> \<{
     int amount = 10;
     acc.sendAmount(amount)@bank.Account;
   }\> (    int::select(heap,
                        acc,
                        bank.Account::$balance)
          = Z(0(1(#)))
        &   boolean::select(heap,
                            acc,
                            bank.Account::$locked)
          = FALSE
        &   int::select(heap,
                        acc,
                        bank.Account::$unsuccessfulWithdraws)
          = Z(0(#))
        &   boolean::select(gHeap,
                            bank.Transaction::select(gHeap,
                                                     acc,
                                                     bank.Account::$lastTransaction),
                            bank.Transaction::$success)
          = TRUE)
}

\proof {
