\javaSource "src";

\programVariables{
    other.SmallExampleCollection c;
}

\include "ghostHeapRules.key";
\problem {
       boolean::select(heap,
                       c,
                       java.lang.Object::<created>)
     = TRUE
   & !  other.DummyObject::select(heap,
                                  c,
                                  other.SmallExampleCollection::$d1)
      = null
   & !  other.DummyObject::select(heap,
                                  c,
                                  other.SmallExampleCollection::$d2)
      = null
   & !  other.DummyObject::select(heap,
                                  c,
                                  other.SmallExampleCollection::$d3)
      = null
   & !  other.DummyObject::select(heap,
                                  c,
                                  other.SmallExampleCollection::$d1)
      = other.DummyObject::select(heap,
                                  c,
                                  other.SmallExampleCollection::$d2)
   & !  other.DummyObject::select(heap,
                                  c,
                                  other.SmallExampleCollection::$d2)
      = other.DummyObject::select(heap,
                                  c,
                                  other.SmallExampleCollection::$d3)
   & !  other.DummyObject::select(heap,
                                  c,
                                  other.SmallExampleCollection::$d1)
      = other.DummyObject::select(heap,
                                  c,
                                  other.SmallExampleCollection::$d3)
   & wellFormedPair(heap, gHeap)
-> \<{
     c.opOnJavaFields2()@other.SmallExampleCollection;
   }\> (    other.DummyObject::select(heap,
                                      other.DummyObject::select(heap,
                                                                c,
                                                                other.SmallExampleCollection::$d1),
                                      other.DummyObject::$otherDummy)
          = other.DummyObject::select(heap,
                                      c,
                                      other.SmallExampleCollection::$d3)
        &   int::select(heap,
                        other.DummyObject::select(heap,
                                                  c,
                                                  other.SmallExampleCollection::$d1),
                        other.DummyObject::$a)
          = Z(2(1(#)))
        &   int::select(heap,
                        other.DummyObject::select(heap,
                                                  c,
                                                  other.SmallExampleCollection::$d2),
                        other.DummyObject::$a)
          = Z(3(#))
        &   other.DummyObject::select(heap,
                                      other.DummyObject::select(heap,
                                                                c,
                                                                other.SmallExampleCollection::$d3),
                                      other.DummyObject::$otherDummy)
          = other.DummyObject::select(heap,
                                      c,
                                      other.SmallExampleCollection::$d2)
        &   int::select(heap,
                        other.DummyObject::select(heap,
                                                  c,
                                                  other.SmallExampleCollection::$d3),
                        other.DummyObject::$a)
          = Z(2(1(#)))
        &   other.DummyObject::select(gHeap,
                                      other.DummyObject::select(gHeap,
                                                                c,
                                                                other.SmallExampleCollection::$gd1),
                                      other.DummyObject::$gOtherDummy)
          = other.DummyObject::select(heap,
                                      c,
                                      other.SmallExampleCollection::$d1)
        &   int::select(gHeap,
                        other.DummyObject::select(gHeap,
                                                  other.DummyObject::select(gHeap,
                                                                            c,
                                                                            other.SmallExampleCollection::$gd1),
                                                  other.DummyObject::$gOtherDummy),
                        other.DummyObject::$ga)
          = int::select(heap,
                        other.DummyObject::select(heap,
                                                  c,
                                                  other.SmallExampleCollection::$d2),
                        other.DummyObject::$a))
}

